  "Description": "Una planta y cuatro elevaciones (A/B/C/D) por cada vista 3D con Section Box activo.",
  "Name": "00_Vistas de sector",
  "ElementResolver": { "ResolutionMap": {} },
  "Inputs": [
    { "Id": "b2010000000000000000000000000001", "Name": "01. Procesar TODOS los sectores", "Type": "boolean", "Type2": "boolean", "Value": "false", "Description": "Enables selection between True and False" },
    { "Id": "b2020000000000000000000000000001", "Name": "02. Filtro por nombre de la vista 3D (si TODOS = False)", "Type": "string", "Type2": "string", "Value": "SECTOR", "Description": "Creates a string." },
    { "Id": "b2030000000000000000000000000001", "Name": "03. Recrear vistas existentes (borra y rehace)", "Type": "boolean", "Type2": "boolean", "Value": "false", "Description": "Enables selection between True and False" },
    { "Id": "b2040000000000000000000000000001", "Name": "04. Subcarpeta del Project Browser (vacio = usar el tipo base)", "Type": "string", "Type2": "string", "Value": "", "Description": "Creates a string." },
    { "Id": "b2050000000000000000000000000001", "Name": "05. Tipo de vista BASE (se duplica para la subcarpeta)", "Type": "string", "Type2": "string", "Value": "", "Description": "Creates a string." },
    { "Id": "b2060000000000000000000000000001", "Name": "06. View template - PLANTA (vacio = ninguno)", "Type": "string", "Type2": "string", "Value": "1P_ILU", "Description": "Creates a string." },
    { "Id": "b2070000000000000000000000000001", "Name": "07. View template - ELEVACIONES (vacio = ninguno)", "Type": "string", "Type2": "string", "Value": "1C_ILU", "Description": "Creates a string." },
    { "Id": "b2080000000000000000000000000001", "Name": "08. Escala de las vistas (1:N)", "Type": "number", "Type2": "number", "Value": "75", "MaximumValue": 500.0, "MinimumValue": 10.0, "StepValue": 5.0, "NumberType": "Integer", "Description": "Produces integer values" },
    { "Id": "b2090000000000000000000000000001", "Name": "09. Bajar el corte bajo el tope de la caja (cm)", "Type": "number", "Type2": "number", "Value": "0", "MaximumValue": 500.0, "MinimumValue": 0.0, "StepValue": 5.0, "NumberType": "Integer", "Description": "Produces integer values" },
    { "Id": "b2100000000000000000000000000001", "Name": "10. Margen del crop (mm)", "Type": "number", "Type2": "number", "Value": "10", "MaximumValue": 100.0, "MinimumValue": 0.0, "StepValue": 1.0, "NumberType": "Integer", "Description": "Produces integer values" },
    {
      "Id": "c1a10000000000000000000000000001",
      "Name": "11. Vinculos y CAD importado en halftone",
      "Type": "boolean",
      "Type2": "boolean",
      "Value": "true",
      "Description": "Enables selection between True and False"
    }
  ],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "a2010000000000000000000000000001",
      "NodeType": "PythonScriptNode",
      "Inputs": [
      { "Id": "a2010000000000000000000000000010", "Name": "IN[0]", "Description": "Input #0", "UsingDefaultValue": false, "Level": 2, "UseLevels": false, "KeepListStructure": false },
      { "Id": "a2010000000000000000000000000011", "Name": "IN[1]", "Description": "Input #1", "UsingDefaultValue": false, "Level": 2, "UseLevels": false, "KeepListStructure": false },
      { "Id": "a2010000000000000000000000000012", "Name": "IN[2]", "Description": "Input #2", "UsingDefaultValue": false, "Level": 2, "UseLevels": false, "KeepListStructure": false },
      { "Id": "a2010000000000000000000000000013", "Name": "IN[3]", "Description": "Input #3", "UsingDefaultValue": false, "Level": 2, "UseLevels": false, "KeepListStructure": false },
      { "Id": "a2010000000000000000000000000014", "Name": "IN[4]", "Description": "Input #4", "UsingDefaultValue": false, "Level": 2, "UseLevels": false, "KeepListStructure": false },
      { "Id": "a2010000000000000000000000000015", "Name": "IN[5]", "Description": "Input #5", "UsingDefaultValue": false, "Level": 2, "UseLevels": false, "KeepListStructure": false },
      { "Id": "a2010000000000000000000000000016", "Name": "IN[6]", "Description": "Input #6", "UsingDefaultValue": false, "Level": 2, "UseLevels": false, "KeepListStructure": false },
      { "Id": "a2010000000000000000000000000017", "Name": "IN[7]", "Description": "Input #7", "UsingDefaultValue": false, "Level": 2, "UseLevels": false, "KeepListStructure": false },
      { "Id": "a2010000000000000000000000000018", "Name": "IN[8]", "Description": "Input #8", "UsingDefaultValue": false, "Level": 2, "UseLevels": false, "KeepListStructure": false },
      { "Id": "a2010000000000000000000000000019", "Name": "IN[9]", "Description": "Input #9", "UsingDefaultValue": false, "Level": 2, "UseLevels": false, "KeepListStructure": false }, {"Id":"a0010000000000000000000000000030","Name":"IN[10]","Description":"Input #10","UsingDefaultValue":false,"Level":2,"UseLevels":false,"KeepListStructure":false}
      ],
      "Outputs": [
        { "Id": "a2010000000000000000000000000002", "Name": "OUT", "Description": "Result of the python script", "UsingDefaultValue": false, "Level": 2, "UseLevels": false, "KeepListStructure": false }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script.",
      "Code": "# 00_Vistas de sector - ILUMINACION: una planta + cuatro elevaciones (A/B/C/D) por\n# cada vista 3D que tenga el Section Box activo. El sector ES la caja: nada de\n# assemblies, grupos ni ejes marcados.\n# Revit 2027 / Dynamo 4 / CPython3\n# IN[0]  = procesar todos los sectores (bool). OJO: arranca en False a proposito.\n#          Tener el Section Box encendido NO convierte a una vista 3D en un sector.\n#          Este modelo tiene varias vistas 3D de trabajo con el Section Box activo\n#          (DETALLE 1, DET 2 LAM-004, \"detalle nuevo fe\"), y con True el graph las\n#          documenta a todas: el 2026-08-11 dejo 40 vistas y 01 pidio 9 laminas.\n# IN[1]  = filtro por nombre de la vista 3D si IN[0] es False (parcial, separado por\n#          comas). Es el que decide QUE es un sector; por defecto \"SECTOR\".\n# IN[2]  = recrear vistas existentes (bool) - borra y vuelve a crear\n# IN[3]  = nombre del tipo de vista, comun a planta y elevaciones (ej. 02_ILUMINACION);\n#          para las elevaciones se resuelve como ViewFamilyType de Section\n# IN[4]  = view template de la PLANTA (vacio = ninguno; si no existe, avisa)\n# IN[5]  = view template de las ELEVACIONES (vacio = ninguno; si no existe, avisa)\n# IN[6]  = margen del crop sobre el borde de la caja, en mm de papel\n# IN[7]  = escala de todas las vistas (1:N) - planta y elevaciones comparten escala.\n#          En este proyecto es 1:75 y se reaplica tambien a las vistas que ya\n#          existian: cambiar la escala aca y volver a correr basta, no hay que\n#          recrearlas (ver preparar_vista, que le gana al view template).\n# IN[8]  = cuanto BAJAR el plano de corte respecto del tope de la caja (cm; 0 = al ras)\n# IN[10] = poner en halftone los vinculos de Revit y los CAD importados (bool)\n# IN[9]  = subcarpeta del Project Browser: se crea un TIPO DE VISTA con ese nombre\n#          (duplicado del tipo base de IN[3]) y se asigna a todas las vistas, que es\n#          lo que hace aparecer el nodo en el browser. Vacio = usar el tipo de IN[3].\n#\n# QUE DESAPARECIO RESPECTO DEL 00 DE ACERO (T003), Y POR QUE\n#\n# 1. El Far Clip Offset ya no es un input. En una elevacion de eje habia que elegir a\n#    mano hasta donde ver porque el eje es una linea infinita: no tenia profundidad\n#    propia. La caja SI la tiene, y es justamente la definicion del sector, asi que el\n#    far clip sale de la caja. Un input aca solo podria contradecirla.\n#\n# 2. Los offsets de corte por tipo de planta (NIPB / P.T. / T.A.) se fueron con los\n#    niveles modelados por assembly. Este modelo tiene UN nivel (\"nivel 1 luminarias\")\n#    y toda la geometria vertical se deriva de la caja: corte en el tope, fondo en el\n#    piso de la caja. El nivel es solo el origen de coordenadas del View Range.\n#\n# 3. Todo el aislamiento por miembros (IsolateElementsTemporary + conversion a\n#    permanente) se fue entero. Con assemblies hacia falta porque una seccion normal\n#    muestra TODO el modelo dentro de su caja y no habia forma de decir \"solo estas\n#    piezas\". Aca la caja no es una aproximacion al sector: es el sector. Lo que la\n#    delimita ya es geometrico -crop en X/Y, View Range o far clip en profundidad- y\n#    filtrar elemento por elemento seria describir dos veces el mismo recorte, con el\n#    riesgo de que las dos descripciones se desincronicen (que es exactamente el bug\n#    que se arreglo en 03 el 2026-08-11).\n\nimport clr\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitServices')\nfrom Autodesk.Revit.DB import (FilteredElementCollector, View, View3D, ViewPlan,\n                               ViewSection, ViewFamilyType, ViewFamily, Level,\n                               UnitUtils, UnitTypeId, XYZ, Element, ElementId,\n                               BuiltInParameter, BuiltInCategory, BoundingBoxXYZ,\n                               Transform, ViewDetailLevel, PlanViewPlane,\n                               RevitLinkInstance, ImportInstance, OverrideGraphicSettings)\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\n\ndoc = DocumentManager.Instance.CurrentDBDocument\n\nlog = []\n\nprocess_all = bool(IN[0])\nfilter_text = (IN[1] or '').strip()\nrecreate = bool(IN[2])\nsec_type_text = (IN[3] or '').strip()\ntpl_text_planta = (IN[4] or '').strip()\ntpl_text_elevacion = (IN[5] or '').strip()\ncrop_margin_mm = float(IN[6])\nescala = int(IN[7]) if IN[7] else 75\nbaja_corte = float(IN[8]) / 30.48 if IN[8] else 0.0    # cm -> pies\nnombre_carpeta = (IN[9] or '').strip()\nhalftone_vinculos = bool(IN[10])\n\n# El MISMO nombre de tipo sirve para planta y elevaciones: son ViewFamilyType\n# distintos (Floor Plan vs Section) que en este proyecto se llaman igual.\nplan_type_text = sec_type_text\n\n# Holgura del plano Top por encima del plano de corte. NO puede ser cero: un View\n# Range con Top == Cut es degenerado y colapsa el espesor del CropBox, dejando la\n# vista sin dibujar (Revit ni siquiera la puede abrir). Heredado de T003, donde el\n# sintoma se diagnostico el 2026-07-28.\nHOLGURA_TOP = 10.0 / 30.48   # cm -> pies\n\n# --- contrato de nombres (lo van a usar 01 y 02 para encontrar las vistas) ---\n# El nombre del SECTOR es el nombre de la vista 3D tal cual (\"SECTOR 01\").\nSUF_PLANTA = ' - PLANTA'\nSUF_ELEV = ' - ELEV '        # + letra\nTIT_PLANTA = ' - PLANTA'\nTIT_ELEV = ' - ELEVACION {}'\n\n# --- las cuatro elevaciones ---\n# (letra, direccion hacia donde MIRA la camara). Los section box de este proyecto\n# estan alineados a X e Y, asi que las cuatro direcciones son los ejes globales.\n# Orden horario partiendo del observador al Sur:\n#   A  observador al Sur   mira al Norte  (+Y)\n#   B  observador al Oeste mira al Este   (+X)\n#   C  observador al Norte mira al Sur    (-Y)\n#   D  observador al Este  mira al Oeste  (-X)\n# Cambiar la convencion de letras = reordenar esta tupla, nada mas.\nELEVACIONES = (('A', XYZ(0.0, 1.0, 0.0)),\n               ('B', XYZ(1.0, 0.0, 0.0)),\n               ('C', XYZ(0.0, -1.0, 0.0)),\n               ('D', XYZ(-1.0, 0.0, 0.0)))\n\n# En T003 las plantas salian SIN simbolos de corte: quince elevaciones de eje\n# ensuciaban el dibujo del acero. Aca son cuatro y marcan de donde sale cada\n# elevacion de la lamina, que es informacion util, asi que por defecto SE VEN.\n# Poner en True para volver al comportamiento de acero.\nOCULTAR_MARCAS_EN_PLANTA = False\n\n\ndef to_m(v):\n    return UnitUtils.ConvertFromInternalUnits(v, UnitTypeId.Meters)\n\n\ndef fmt_cota(m):\n    # formato chileno (punto de miles, coma decimal), igual que las vistas que ya\n    # existen en el modelo\n    s = '{:,.2f}'.format(m)\n    return s.replace(',', '@').replace('.', ',').replace('@', '.')\n\n\ndef elem_name(e):\n    try:\n        return e.Name\n    except Exception:\n        return Element.Name.__get__(e)\n\n\ndef set_name(e, name):\n    try:\n        e.Name = name\n    except Exception:\n        Element.Name.__set__(e, name)\n\n\n# --- tipo de vista para las elevaciones (debe ser ViewFamily.Section) ---\nsec_vft = None\ntipos_section = [t for t in FilteredElementCollector(doc).OfClass(ViewFamilyType)\n                 if t.ViewFamily == ViewFamily.Section]\nif sec_type_text:\n    low = sec_type_text.lower()\n    for t in tipos_section:\n        if elem_name(t).lower() == low:\n            sec_vft = t\n            break\n    if sec_vft is None:\n        log.append('AVISO: no existe el tipo de vista de seccion {}; se usa el primero disponible.'.format(sec_type_text))\n        log.append('Tipos de Section en este proyecto: ' + ', '.join(sorted(elem_name(t) for t in tipos_section)))\nelse:\n    # Campo vacio: se elige el primero por orden alfabetico, pero se lista el\n    # catalogo igual. La primera corrida del graph en un proyecto nuevo es\n    # justamente donde nadie sabe todavia como se llaman los tipos; que el log lo\n    # diga evita tener que ir a buscarlos al Project Browser.\n    log.append('Tipo de vista sin especificar. Tipos de Section en este proyecto: '\n               + ', '.join(sorted(elem_name(t) for t in tipos_section)))\nif sec_vft is None:\n    if tipos_section:\n        sec_vft = sorted(tipos_section, key=lambda t: elem_name(t))[0]\n        log.append('Elevaciones: se usa el tipo de seccion \"{}\".'.format(elem_name(sec_vft)))\n    else:\n        log.append('ERROR: no hay ningun ViewFamilyType de tipo Section en el proyecto; no se pueden crear elevaciones.')\n\n# --- tipo de vista para la planta ---\n# En acero se prefería StructuralPlan; aca la planta es de ILUMINACION y manda\n# FloorPlan (decision de Javier, 2026-08-11). StructuralPlan queda como fallback\n# solo si el proyecto no tuviera ningun tipo de Floor Plan.\nplan_vft = None\nFAMILIAS_PLAN = (ViewFamily.FloorPlan, ViewFamily.StructuralPlan)\ntipos_plan = [t for t in FilteredElementCollector(doc).OfClass(ViewFamilyType)\n              if t.ViewFamily in FAMILIAS_PLAN]\nif plan_type_text:\n    lowp = plan_type_text.lower()\n    for t in tipos_plan:\n        if elem_name(t).lower() == lowp and t.ViewFamily == ViewFamily.FloorPlan:\n            plan_vft = t\n            break\n    if plan_vft is None:\n        for t in tipos_plan:\n            if elem_name(t).lower() == lowp:\n                plan_vft = t\n                break\n    if plan_vft is None:\n        log.append('AVISO: no existe el tipo de vista de planta {}; se usa el primero disponible.'.format(plan_type_text))\n        log.append('Tipos de planta en este proyecto: ' + ', '.join(sorted(elem_name(t) for t in tipos_plan)))\nelse:\n    log.append('Tipos de planta en este proyecto: '\n               + ', '.join(sorted(elem_name(t) for t in tipos_plan)))\nif plan_vft is None:\n    de_piso = [t for t in tipos_plan if t.ViewFamily == ViewFamily.FloorPlan]\n    fuente = de_piso if de_piso else tipos_plan\n    if fuente:\n        plan_vft = sorted(fuente, key=lambda t: elem_name(t))[0]\n        log.append('Planta: se usa el tipo \"{}\".'.format(elem_name(plan_vft)))\n    else:\n        log.append('ERROR: no hay ningun ViewFamilyType de planta (FloorPlan/StructuralPlan) en el proyecto.')\n\n\ndef tipo_carpeta(base_vft, familias, etiqueta):\n    # \"Subcarpeta del Project Browser\" = un TIPO DE VISTA propio.\n    #\n    # El Project Browser agrupa las vistas por \"Family and Type\", asi que la forma\n    # de conseguir un nodo propio SIN depender de que alguien configure a mano un\n    # esquema de Browser Organization es crear un ViewFamilyType con ese nombre y\n    # asignarselo a todas las vistas. Se duplica del tipo base (input 03) para\n    # heredar su grafismo.\n    #\n    # OJO: la ViewFamily (Floor Plans / Sections) es un nivel de agrupacion POR\n    # ENCIMA del tipo, asi que esto da DOS nodos con el mismo nombre -uno con las\n    # plantas y otro con las elevaciones-, no una carpeta unica con todo.\n    #\n    # Duplicate() necesita una transaccion abierta: se llama desde el bloque\n    # principal, no aca arriba.\n    if not nombre_carpeta or base_vft is None:\n        return base_vft\n    low = nombre_carpeta.lower()\n    for t in FilteredElementCollector(doc).OfClass(ViewFamilyType):\n        if t.ViewFamily in familias and elem_name(t).lower() == low:\n            return t\n    try:\n        nuevo = base_vft.Duplicate(nombre_carpeta)\n        log.append('Carpeta \"{}\": tipo de vista creado para {} (duplicado de \"{}\").'.format(\n            nombre_carpeta, etiqueta, elem_name(base_vft)))\n        return nuevo\n    except Exception as e:\n        log.append('ERROR creando el tipo de vista \"{}\" para {}: {}'.format(nombre_carpeta, etiqueta, e))\n        return base_vft\n\n\n# --- niveles: solo anclan el View Range de la planta ---\ndef elev_nivel(l):\n    # SIEMPRE ProjectElevation, NUNCA Elevation.\n    # Heredado de T003: ese modelo usa \"Elevation Base = Shared\" y los niveles\n    # reportan la cota real del sitio mientras la geometria vive cerca del origen\n    # del proyecto. Anclar el View Range con Elevation mandaba el plano de corte\n    # miles de pies fuera del modelo y las plantas salian VACIAS. ProjectElevation\n    # va siempre en coordenadas de proyecto, el mismo sistema en el que se mide la\n    # geometria (y el mismo en el que viene el Section Box).\n    try:\n        return l.ProjectElevation\n    except Exception:\n        return l.Elevation\n\n\nniveles = sorted(FilteredElementCollector(doc).OfClass(Level), key=elev_nivel)\nif not niveles:\n    log.append('ERROR: el proyecto no tiene ningun Level; ViewPlan.Create no puede crear plantas.')\nelse:\n    try:\n        _l0 = niveles[0]\n        if abs(_l0.Elevation - _l0.ProjectElevation) > 0.01:\n            log.append('NOTA: el modelo usa cota compartida (nivel {}: Elevation {} m vs ProjectElevation {} m).'.format(\n                elem_name(_l0), fmt_cota(to_m(_l0.Elevation)), fmt_cota(to_m(_l0.ProjectElevation))))\n            log.append('      El View Range se ancla con ProjectElevation, que es el sistema de la geometria.')\n    except Exception:\n        pass\n\n\ndef nivel_para(z):\n    # El nivel mas alto que no pase de z. Con un solo nivel en el modelo devuelve\n    # siempre ese; la busqueda existe para que agregar niveles no rompa nada.\n    # NO define la cota de la planta: el corte y el fondo salen de la caja y aca\n    # solo se elige el origen desde el que se miden los offsets del View Range.\n    debajo = [l for l in niveles if elev_nivel(l) <= z + 1e-6]\n    return debajo[-1] if debajo else niveles[0]\n\n\n# --- view templates ---\ntemplates = [t for t in FilteredElementCollector(doc).OfClass(View) if t.IsTemplate]\n\n\ndef resolver_template(nombre, etiqueta):\n    if not nombre:\n        log.append('Sin view template para {} (campo vacio).'.format(etiqueta))\n        return None\n    low = nombre.lower()\n    for t in templates:\n        if elem_name(t).lower() == low:\n            return t\n    cands = [t for t in templates if low in elem_name(t).lower()]\n    if len(cands) == 1:\n        return cands[0]\n    log.append('AVISO: no existe un view template de {} que coincida con {}; esas vistas quedan sin template.'.format(etiqueta, nombre))\n    return None\n\n\nview_template_planta = resolver_template(tpl_text_planta, 'la planta')\nview_template_elevacion = resolver_template(tpl_text_elevacion, 'las elevaciones')\nif templates:\n    log.append('Templates cargados en el proyecto: ' + ', '.join(sorted(elem_name(t) for t in templates)))\nelse:\n    log.append('AVISO: no hay ningun view template cargado en este proyecto.')\n\n\n# --- vinculos y CAD importado: siempre atenuados ---\ndef elementos_a_atenuar():\n    # Los vinculos de Revit y los CAD -importados o vinculados; ImportInstance cubre los dos-.\n    # Se juntan UNA VEZ para todo el documento y no vista por vista: el override se guarda\n    # igual aunque el elemento no se vea en esa vista, asi que no hace falta regenerar el\n    # modelo por cada vista nueva para que el collector los encuentre.\n    if not halftone_vinculos:\n        return []\n    res = []\n    for clase, etiqueta in ((RevitLinkInstance, 'vinculos de Revit'),\n                            (ImportInstance, 'CAD importado o vinculado')):\n        try:\n            res.extend(FilteredElementCollector(doc).OfClass(clase)\n                       .WhereElementIsNotElementType())\n        except Exception as e:\n            log.append('AVISO: no se pudieron listar los {} ({}).'.format(etiqueta, e))\n    return res\n\n\ndef atenuar_vinculos(v, sname, label):\n    # Halftone POR ELEMENTO, no por categoria ni por la pestana \"Revit Links\" de la V/G.\n    #\n    # Por elemento porque es lo unico que sirve para las dos cosas a la vez y no pelea con el\n    # view template: un DWG importado no tiene UNA categoria sino las suyas propias -cada\n    # importacion crea su juego, y habria que enumerarlas- y la pestana de vinculos es\n    # justamente de las que un view template controla, asi que 1P_ILU o 1C_ILU le ganarian.\n    # El override por elemento no lo maneja el template: se aplica DESPUES y queda.\n    #\n    # El precio es que es una foto: un vinculo que se agregue despues de correr este paso no\n    # sale atenuado hasta que se vuelva a correr.\n    if not ATENUAR:\n        return\n    ogs = OverrideGraphicSettings()\n    ogs.SetHalftone(True)\n    puestos = 0\n    for el in ATENUAR:\n        try:\n            v.SetElementOverrides(el.Id, ogs)\n            puestos += 1\n        except Exception:\n            pass\n    if puestos < len(ATENUAR):\n        log.append('AVISO {}: en {} solo {} de {} vinculo(s)/importacion(es) aceptaron el '\n                   'halftone.'.format(sname, label, puestos, len(ATENUAR)))\n\nATENUAR = elementos_a_atenuar()\nif ATENUAR:\n    log.append('{} vinculo(s) de Revit y CAD importado van a quedar en halftone en cada '\n               'vista creada.'.format(len(ATENUAR)))\n\n\n# ------------------------------------------------------------ sectores = vistas 3D\nTOL_ROT = 1e-6\n\n\ndef caja_del_sector(v3d, sname):\n    # Devuelve (min, max) en coordenadas de MUNDO, o None.\n    #\n    # GetSectionBox() entrega Min/Max en el sistema LOCAL de su propio Transform,\n    # no en coordenadas de mundo: leerlos directo funciona solo mientras el\n    # Transform sea la identidad. Se transforman las 8 esquinas siempre, aunque en\n    # este proyecto las cajas esten alineadas, porque el dia que alguien rote una\n    # el error seria silencioso -la vista saldria con el crop corrido, no con un\n    # mensaje- y ese es el peor tipo de falla.\n    try:\n        bb = v3d.GetSectionBox()\n    except Exception as e:\n        log.append('ERROR {}: no se pudo leer el Section Box: {}'.format(sname, e))\n        return None\n    if bb is None:\n        return None\n    t = bb.Transform\n    rotada = (abs(t.BasisX.X - 1.0) > TOL_ROT or abs(t.BasisY.Y - 1.0) > TOL_ROT\n              or abs(t.BasisZ.Z - 1.0) > TOL_ROT)\n    if rotada:\n        log.append('AVISO {}: el Section Box esta ROTADO respecto de X/Y.'.format(sname))\n        log.append('       Las vistas se generan contra su envolvente alineada a los ejes, o sea')\n        log.append('       abarcando MAS que la caja. Para que el recorte sea exacto habria que')\n        log.append('       orientar las elevaciones a la caja y darle al crop de la planta una')\n        log.append('       forma rotada (SetCropShape). Hoy el graph no lo hace.')\n    xs, ys, zs = [], [], []\n    for x in (bb.Min.X, bb.Max.X):\n        for y in (bb.Min.Y, bb.Max.Y):\n            for z in (bb.Min.Z, bb.Max.Z):\n                p = t.OfPoint(XYZ(x, y, z))\n                xs.append(p.X)\n                ys.append(p.Y)\n                zs.append(p.Z)\n    return (XYZ(min(xs), min(ys), min(zs)), XYZ(max(xs), max(ys), max(zs)))\n\n\nsectores = []\nfor v3d in FilteredElementCollector(doc).OfClass(View3D):\n    if v3d.IsTemplate:\n        continue\n    try:\n        if not v3d.IsSectionBoxActive:\n            continue\n    except Exception:\n        continue\n    sectores.append(v3d)\nsectores.sort(key=elem_name)\n\nif not sectores:\n    log.append('AVISO: no hay ninguna vista 3D con el Section Box ACTIVO.')\n    log.append('       El sector se define ahi: crear una vista 3D por sector, activarle el')\n    log.append('       Section Box y ajustarlo al sector. El nombre de esa vista es el nombre')\n    log.append('       del sector y lo heredan todas las vistas que crea este graph.')\n\ntargets = sectores\nif not process_all:\n    tokens = [t.strip().lower() for t in filter_text.split(',') if t.strip()]\n    if tokens:\n        targets = [v for v in sectores if any(tok in elem_name(v).lower() for tok in tokens)]\n        if not targets:\n            log.append('AVISO: ningun sector coincide con \"{}\".'.format(filter_text))\n            log.append('Sectores disponibles: ' + ', '.join(elem_name(v) for v in sectores))\n    else:\n        targets = []\n        log.append('ERROR: \"Todos\" esta en False y el filtro esta vacio.')\n\n\n# ---------------------------------------------------------------- indice de vistas\nview_ids = {}\nfor v in FilteredElementCollector(doc).OfClass(View):\n    if not v.IsTemplate:\n        view_ids[elem_name(v)] = v.Id\n\n\n# ---------------------------------------------------------------- ajustes de vista\n\ndef fijar_far_clip(v, profundidad, sname, label):\n    # La profundidad de una elevacion la manda la CAJA, no un input.\n    #\n    # ViewSection.CreateSection ya nace con el far clip a la medida del\n    # BoundingBoxXYZ que se le paso, pero hay que reafirmarlo DESPUES del template:\n    # si el template trae su propio Far Clip Offset, pisa el de la caja y la\n    # elevacion empieza a mostrar (o a comerse) sectores vecinos.\n    # 0 = No clip, 1 = Clip without line, 2 = Clip with line.\n    try:\n        pa = v.get_Parameter(BuiltInParameter.VIEWER_BOUND_ACTIVE_FAR)\n        if pa is not None and not pa.IsReadOnly and pa.AsInteger() == 0:\n            pa.Set(1)\n    except Exception:\n        pass\n    try:\n        p = v.get_Parameter(BuiltInParameter.VIEWER_BOUND_OFFSET_FAR)\n        if p is not None and not p.IsReadOnly:\n            p.Set(profundidad)\n    except Exception as e:\n        log.append('AVISO {}: no se pudo fijar el Far Clip de {}: {}'.format(sname, label, e))\n\n\ndef fijar_view_range(vplan, z_corte, z_fondo, level, sname, label):\n    # En una ViewPlan la profundidad no la controla el Far Clip Offset sino el\n    # View Range. Todos los planos se anclan al MISMO nivel y se expresan como\n    # offset respecto de su elevacion, asi que el nivel elegido es indiferente:\n    # es solo el origen de coordenadas del rango.\n    #   Top    = Cut + HOLGURA_TOP\n    #   Cut    = tope de la caja (menos lo que pida el input 08)\n    #   Bottom = View Depth = piso de la caja\n    #\n    # ORDEN ESTRICTO: Revit exige Top >= Cut >= Bottom >= ViewDepth. Con Top == Cut\n    # el rango de altura colapsa a cero, el CropBox hereda espesor nulo y la planta\n    # no dibuja NADA -Revit ni siquiera la puede abrir- aunque un\n    # FilteredElementCollector(doc, view.Id) siga contando elementos visibles.\n    e = elev_nivel(level)\n    corte = z_corte - e\n    fondo = z_fondo - e\n    if fondo > corte - HOLGURA_TOP:\n        # caja demasiado chata (o corte bajado de mas): se fuerza un rango sano\n        log.append('AVISO {}: la caja de {} es mas baja que la holgura minima; se abre el rango.'.format(sname, label))\n        fondo = corte - HOLGURA_TOP\n    top = corte + HOLGURA_TOP\n    try:\n        vr = vplan.GetViewRange()\n        for plano, off in ((PlanViewPlane.TopClipPlane, top),\n                           (PlanViewPlane.CutPlane, corte),\n                           (PlanViewPlane.BottomClipPlane, fondo),\n                           (PlanViewPlane.ViewDepthPlane, fondo)):\n            vr.SetLevelId(plano, level.Id)\n            vr.SetOffset(plano, off)\n        vplan.SetViewRange(vr)\n        log.append('{}: {} cortada en EL. {}, fondo en EL. {} ({:.2f} m de profundidad).'.format(\n            sname, label, fmt_cota(to_m(z_corte)), fmt_cota(to_m(z_fondo)),\n            to_m(z_corte - z_fondo)))\n    except Exception as ex:\n        log.append('ERROR {}: no se pudo fijar el View Range de {}: {}'.format(sname, label, ex))\n\n\ndef ajustar_crop_a_caja(v, pmin, pmax, sname, label):\n    # Recorta el crop de la PLANTA a la huella de la caja + margen de papel.\n    # Se trabaja en los ejes propios de la vista (via el Transform del CropBox\n    # actual) en vez de asumir que coinciden con X/Y del proyecto.\n    bb = v.CropBox\n    inv = bb.Transform.Inverse\n    minx = miny = float('inf')\n    maxx = maxy = float('-inf')\n    for x in (pmin.X, pmax.X):\n        for y in (pmin.Y, pmax.Y):\n            for z in (pmin.Z, pmax.Z):\n                p = inv.OfPoint(XYZ(x, y, z))\n                if p.X < minx: minx = p.X\n                if p.X > maxx: maxx = p.X\n                if p.Y < miny: miny = p.Y\n                if p.Y > maxy: maxy = p.Y\n    margen = crop_margin_mm / 304.8 * (v.Scale if v.Scale > 0 else 1)\n    # El espesor en Z se hereda del crop actual, pero NUNCA puede quedar en cero:\n    # un BoundingBoxXYZ degenerado deja la vista sin dibujar. En una planta el Z\n    # del crop lo deriva Revit del View Range, asi que si el rango venia colapsado\n    # esto es la ultima linea de defensa.\n    zmin_c = bb.Min.Z\n    zmax_c = bb.Max.Z\n    if zmax_c - zmin_c < 1e-6:\n        zmin_c = zmin_c - 1.0\n        zmax_c = zmax_c + 1.0\n        log.append('AVISO {}: el crop de {} venia con espesor cero; se le dio 2 m.'.format(sname, label))\n    nuevo = BoundingBoxXYZ()\n    nuevo.Transform = bb.Transform\n    nuevo.Min = XYZ(minx - margen, miny - margen, zmin_c)\n    nuevo.Max = XYZ(maxx + margen, maxy + margen, zmax_c)\n    v.CropBox = nuevo\n    desactivar_annotation_crop(v)\n    log.append('   crop de {}: {:.2f} x {:.2f} m.'.format(\n        label, to_m(maxx - minx + 2 * margen), to_m(maxy - miny + 2 * margen)))\n\n\ndef desactivar_annotation_crop(v):\n    # El Annotation Crop se deja INACTIVO a proposito: asi cotas, tags y leaders,\n    # que viven por fuera del borde del sector, no quedan cortados. El precio es\n    # que Revit lo auto-expande hasta abarcar toda la anotacion -por eso el\n    # recuadro punteado queda lejos del dibujo-, pero el marco que regula el\n    # tamaño en lamina es el CropBox, no este.\n    try:\n        v.GetCropRegionShapeManager().IsAnnotationCropActive = False\n    except Exception:\n        pass\n\n\n_aviso_secc = [False]\n\n\ndef ocultar_simbolos_corte(v, sname=None, label=None):\n    # Apaga la categoria Sections: el SIMBOLO de corte (linea, cabeza, cola y\n    # burbuja). No borra ni afecta a las elevaciones en si, solo su marca.\n    # En las ELEVACIONES evita que las otras tres del mismo sector las crucen.\n    try:\n        cat = ElementId(BuiltInCategory.OST_Sections)\n        if v.CanCategoryBeHidden(cat):\n            v.SetCategoryHidden(cat, True)\n        elif sname is not None and not _aviso_secc[0]:\n            _aviso_secc[0] = True\n            log.append('AVISO {}: la categoria Sections no se puede ocultar en {};'.format(sname, label))\n            log.append('       la controla el view template, hay que apagarla ahi.')\n    except Exception as e:\n        if sname is not None and not _aviso_secc[0]:\n            _aviso_secc[0] = True\n            log.append('AVISO {}: no se pudo ocultar el simbolo de seccion en {}: {}'.format(sname, label, e))\n\n\ndef preparar_vista(v, sname, label, profundidad=None):\n    # ajustes comunes a toda vista creada por este graph.\n    # El tipo de vista es lo que define la carpeta del Project Browser, y se\n    # reaplica tambien a las vistas que YA existian: asi cambiar el nombre de la\n    # carpeta no obliga a recrearlas. Va primero, porque cambiar el tipo puede\n    # arrastrar propiedades que los ajustes de mas abajo vuelven a fijar.\n    try:\n        objetivo = plan_vft if isinstance(v, ViewPlan) else sec_vft\n        if objetivo is not None and v.GetTypeId() != objetivo.Id:\n            v.ChangeTypeId(objetivo.Id)\n    except Exception as e:\n        log.append('AVISO {}: no se pudo cambiar el tipo de vista de {}: {}'.format(sname, label, e))\n    try:\n        v.Scale = escala\n    except Exception:\n        pass\n    try:\n        v.DetailLevel = ViewDetailLevel.Fine\n    except Exception:\n        pass\n    try:\n        # \"Crop View\" activo, pero SIN dibujar el rectangulo: sin el recorte la\n        # vista ocupa su extension completa y 01/02 calculan bloques mucho mas\n        # grandes de lo real.\n        if not v.CropBoxActive:\n            v.CropBoxActive = True\n        if v.CropBoxVisible:\n            v.CropBoxVisible = False\n    except Exception as e:\n        log.append('ERROR {} activando Crop View en {}: {}'.format(sname, label, e))\n    objetivo_tpl = view_template_planta if isinstance(v, ViewPlan) else view_template_elevacion\n    if objetivo_tpl is not None:\n        try:\n            if v.ViewTemplateId != objetivo_tpl.Id:\n                v.ViewTemplateId = objetivo_tpl.Id\n            # la escala la manda el input, no el template\n            if v.Scale != escala:\n                v.Scale = escala\n        except Exception as e:\n            log.append('ERROR {} aplicando template a {}: {}'.format(sname, label, e))\n    # El halftone va DESPUES del template a proposito: ver atenuar_vinculos.\n    atenuar_vinculos(v, sname, label)\n    # Far Clip despues del template: si el template trae su propio valor, gana la caja.\n    if profundidad is not None:\n        fijar_far_clip(v, profundidad, sname, label)\n    if isinstance(v, ViewPlan):\n        if OCULTAR_MARCAS_EN_PLANTA:\n            ocultar_simbolos_corte(v, sname, label)\n    else:\n        ocultar_simbolos_corte(v)\n\n\ndef set_titulo(v, texto):\n    # titulo mostrado en lamina (Title on Sheet), sin tocar el nombre interno\n    p = v.get_Parameter(BuiltInParameter.VIEW_DESCRIPTION)\n    if p is None or p.IsReadOnly:\n        return\n    if p.AsString() != texto:\n        p.Set(texto)\n\n\n# ---------------------------------------------------------------- creacion\n\ndef borrar_si_toca(vname, sname, label):\n    # devuelve (vista existente o None, hay_que_conservarla)\n    if vname not in view_ids:\n        return None, False\n    if recreate:\n        try:\n            doc.Delete(view_ids[vname])\n        except Exception:\n            # Revit NO deja borrar la vista activa ni una abierta en pestaña.\n            # Heredado de T003: con la vista abierta en pantalla, doc.Delete tiraba\n            # \"ElementId cannot be deleted\", la excepcion subia y el sector entero\n            # se quedaba sin ninguna vista. Ahora se reutiliza y la corrida sigue.\n            log.append('AVISO {}: no se pudo borrar {}; probablemente esta abierta en Revit.'.format(sname, label))\n            log.append('       Cerrar esa vista y volver a correr si se quiere rehacerla desde cero.')\n            log.append('       Por ahora se reutiliza la existente y se le reaplican los ajustes.')\n            return doc.GetElement(view_ids[vname]), True\n        del view_ids[vname]\n        log.append('{}: {} anterior eliminada (tambien su viewport si estaba en un sheet).'.format(sname, label))\n        return None, False\n    return doc.GetElement(view_ids[vname]), True\n\n\ndef limpiar_sobrantes(sname):\n    # Con \"recrear\" activo se borran TODAS las elevaciones previas del sector, no\n    # solo las cuatro que esta corrida va a rehacer: si alguna vez se cambia la\n    # convencion de letras, las viejas quedarian huerfanas con un nombre que ya no\n    # aplica y 02 las seguiria colocando en lamina.\n    pref = sname + SUF_ELEV\n    for vname in list(view_ids.keys()):\n        if vname.startswith(pref):\n            try:\n                doc.Delete(view_ids[vname])\n                del view_ids[vname]\n            except Exception:\n                pass\n\n\ndef crear_planta(sname, pmin, pmax):\n    global plantas_creadas, saltadas\n    label = 'planta'\n    if plan_vft is None or not niveles:\n        log.append('ERROR {}: no se puede crear la planta (falta tipo de vista o nivel).'.format(sname))\n        return None\n    vname = sname + SUF_PLANTA\n    z_corte = pmax.Z - baja_corte\n    level = nivel_para(z_corte)\n    v, saltar = borrar_si_toca(vname, sname, label)\n    if saltar:\n        saltadas += 1\n    else:\n        v = ViewPlan.Create(doc, plan_vft.Id, level.Id)\n        set_name(v, vname)\n        view_ids[vname] = v.Id\n        plantas_creadas += 1\n        log.append('OK {}: planta creada sobre el nivel {}, escala 1:{}.'.format(\n            sname, elem_name(level), escala))\n    if v is None:\n        return None\n    # Una planta ya existente NO se salta entera: se le vuelven a aplicar escala,\n    # template, view range, crop y titulo. Con \"continue\" las vistas de corridas\n    # viejas quedarian congeladas con los defaults de entonces.\n    preparar_vista(v, sname, label)\n    fijar_view_range(v, z_corte, pmin.Z, level, sname, label)\n    ajustar_crop_a_caja(v, pmin, pmax, sname, label)\n    set_titulo(v, sname + TIT_PLANTA)\n    return v\n\n\ndef crear_elevacion(sname, letra, mirada, pmin, pmax):\n    # Seccion real del modelo, orientada a una cara de la caja.\n    #\n    # El BoundingBoxXYZ que recibe CreateSection define las TRES dimensiones de la\n    # vista: ancho y alto del crop en X/Y locales, y profundidad en Z local. Por eso\n    # la elevacion queda recortada al sector sin filtrar un solo elemento: la caja\n    # que delimita el sector y la caja que delimita la vista son la misma.\n    label = 'elevacion ' + letra\n    if sec_vft is None:\n        # se comprueba ANTES de borrar_si_toca: si no hay tipo de seccion no se va a\n        # poder recrear nada, y borrar la elevacion vieja dejaria al sector peor que\n        # como estaba.\n        return None, False, 0.0\n    vname = sname + SUF_ELEV + letra\n    existente, saltar = borrar_si_toca(vname, sname, label)\n\n    # sistema local de la vista: BasisZ apunta HACIA el observador (contrario a la\n    # mirada), BasisY es la vertical y BasisX se deriva para que quede derecho\n    # (BasisX x BasisY = BasisZ).\n    bz = mirada.Negate().Normalize()\n    by = XYZ.BasisZ\n    bx = by.CrossProduct(bz).Normalize()\n    centro = XYZ((pmin.X + pmax.X) / 2.0, (pmin.Y + pmax.Y) / 2.0, (pmin.Z + pmax.Z) / 2.0)\n\n    lxmin = lymin = lzmin = float('inf')\n    lxmax = lymax = lzmax = float('-inf')\n    for x in (pmin.X, pmax.X):\n        for y in (pmin.Y, pmax.Y):\n            for z in (pmin.Z, pmax.Z):\n                rel = XYZ(x, y, z) - centro\n                lx = rel.DotProduct(bx)\n                ly = rel.DotProduct(by)\n                lz = rel.DotProduct(bz)\n                if lx < lxmin: lxmin = lx\n                if lx > lxmax: lxmax = lx\n                if ly < lymin: lymin = ly\n                if ly > lymax: lymax = ly\n                if lz < lzmin: lzmin = lz\n                if lz > lzmax: lzmax = lz\n\n    profundidad = lzmax - lzmin\n    # El margen se aplica SOLO en X/Y (las dos direcciones de papel). En Z seria\n    # profundidad de mas, o sea sector vecino colandose en la elevacion.\n    m = crop_margin_mm / 304.8 * escala\n    t = Transform.Identity\n    t.BasisX = bx\n    t.BasisY = by\n    t.BasisZ = bz\n    t.Origin = centro\n    caja = BoundingBoxXYZ()\n    caja.Transform = t\n    caja.Min = XYZ(lxmin - m, lymin - m, lzmin)\n    caja.Max = XYZ(lxmax + m, lymax + m, lzmax)\n\n    if saltar:\n        return existente, True, profundidad\n    v = ViewSection.CreateSection(doc, sec_vft.Id, caja)\n    set_name(v, vname)\n    view_ids[vname] = v.Id\n    return v, False, profundidad\n\n\n# ---------------------------------------------------------------- main\n\nplantas_creadas = 0\nelevs_creadas = 0\nsaltadas = 0\nresumen = []\n\nTransactionManager.Instance.EnsureInTransaction(doc)\ntry:\n    # La subcarpeta del Project Browser se materializa como un tipo de vista propio\n    # (ver tipo_carpeta). Tiene que resolverse DENTRO de la transaccion porque\n    # duplica un ViewFamilyType, y antes del bucle para que todas las vistas de esta\n    # corrida nazcan ya con el tipo correcto.\n    if nombre_carpeta:\n        plan_vft = tipo_carpeta(plan_vft, FAMILIAS_PLAN, 'las plantas')\n        sec_vft = tipo_carpeta(sec_vft, (ViewFamily.Section,), 'las elevaciones')\n        # Regenerate obligatorio: sin esto, las vistas creadas en ESTA MISMA corrida\n        # nacian con el tipo BASE en vez del nuevo -Revit no deja el tipo recien\n        # duplicado listo para usarse en otras creaciones de la misma transaccion\n        # hasta que se regenera- y habia que correr el graph dos veces.\n        doc.Regenerate()\n\n    for v3d in targets:\n        sname = elem_name(v3d)\n        try:\n            caja = caja_del_sector(v3d, sname)\n            if caja is None:\n                log.append('ERROR {}: la vista 3D no devolvio Section Box; se omite.'.format(sname))\n                continue\n            pmin, pmax = caja\n            if (pmax.X - pmin.X) < 1e-6 or (pmax.Y - pmin.Y) < 1e-6 or (pmax.Z - pmin.Z) < 1e-6:\n                log.append('ERROR {}: el Section Box es degenerado (alguna dimension en cero); se omite.'.format(sname))\n                continue\n            log.append('{}: caja de {:.2f} x {:.2f} x {:.2f} m, entre EL. {} y EL. {}.'.format(\n                sname, to_m(pmax.X - pmin.X), to_m(pmax.Y - pmin.Y), to_m(pmax.Z - pmin.Z),\n                fmt_cota(to_m(pmin.Z)), fmt_cota(to_m(pmax.Z))))\n\n            if recreate:\n                limpiar_sobrantes(sname)\n\n            # ---------- 1. la planta ----------\n            v_pl = crear_planta(sname, pmin, pmax)\n\n            # ---------- 2. las cuatro elevaciones ----------\n            n_elev = 0\n            for letra, mirada in ELEVACIONES:\n                label = 'elevacion ' + letra\n                try:\n                    velev, saltar, profundidad = crear_elevacion(sname, letra, mirada, pmin, pmax)\n                    if velev is None:\n                        continue\n                    # Una elevacion ya existente NO se salta entera: se le vuelven a\n                    # aplicar escala, template, far clip y titulo, por lo mismo que\n                    # la planta.\n                    if saltar:\n                        saltadas += 1\n                    else:\n                        elevs_creadas += 1\n                    n_elev += 1\n                    preparar_vista(velev, sname, label, profundidad)\n                    desactivar_annotation_crop(velev)\n                    set_titulo(velev, sname + TIT_ELEV.format(letra))\n                    log.append('{} {}: {}.'.format(\n                        'OK' if not saltar else '  ', sname,\n                        label + (' creada' if not saltar else ' ya existia, ajustes reaplicados')))\n                except Exception as e:\n                    log.append('ERROR {} creando {}: {}'.format(sname, label, e))\n\n            resumen.append('{}: {} planta + {} elevacion(es) = {} vista(s).'.format(\n                sname, 1 if v_pl is not None else 0, n_elev,\n                (1 if v_pl is not None else 0) + n_elev))\n        except Exception as e:\n            log.append('ERROR {}: {}'.format(sname, e))\nfinally:\n    TransactionManager.Instance.TransactionTaskDone()\n\nlog.insert(0, 'Sectores procesados: {} | plantas creadas: {} | elevaciones creadas: {} | saltadas: {}'.format(\n    len(targets), plantas_creadas, elevs_creadas, saltadas))\nfor i, linea in enumerate(resumen):\n    log.insert(1 + i, '  ' + linea)\nOUT = log\n"
    },
