      { "Id": "a9010000000000000000000000000011", "Name": "IN[1]", "Description": "Input #1", "UsingDefaultValue": false, "Level": 2, "UseLevels": false, "KeepListStructure": false },
      { "Id": "a9010000000000000000000000000012", "Name": "IN[2]", "Description": "Input #2", "UsingDefaultValue": false, "Level": 2, "UseLevels": false, "KeepListStructure": false },
      { "Id": "a9010000000000000000000000000013", "Name": "IN[3]", "Description": "Input #3", "UsingDefaultValue": false, "Level": 2, "UseLevels": false, "KeepListStructure": false },
      { "Id": "a9010000000000000000000000000014", "Name": "IN[4]", "Description": "Input #4", "UsingDefaultValue": false, "Level": 2, "UseLevels": false, "KeepListStructure": false },
      { "Id": "a9010000000000000000000000000015", "Name": "IN[5]", "Description": "Input #5", "UsingDefaultValue": false, "Level": 2, "UseLevels": false, "KeepListStructure": false }
      ],
      "Outputs": [
        { "Id": "a9010000000000000000000000000002", "Name": "OUT", "Description": "Result of the python script", "UsingDefaultValue": false, "Level": 2, "UseLevels": false, "KeepListStructure": false }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script.",
      "Code": "# 01_Calcular y crear laminas - ILUMINACION\n# Calcula cuantas laminas hacen falta para las vistas de sector pendientes,\n# simulando EXACTAMENTE el mismo empaquetado que 02_Colocar vistas en laminas, y\n# crea esa cantidad con la numeracion incremental de siempre.\n#\n# Regla de aislamiento (estandar del proyecto): cada lamina contiene vistas de UN\n# SOLO sector. Las vistas de un sector fluyen por tantas laminas como haga falta,\n# pero el sector siguiente SIEMPRE empieza en una lamina nueva.\n#\n# Revit 2027 / Dynamo 4 / CPython3\n# IN[0] = tipo de vineta (dropdown Family Types)\n# IN[1] = numero del primer sheet\n# IN[2] = nombre del primer sheet\n# IN[3] = procesar todos los sectores (bool)\n# IN[4] = filtro de sectores si IN[3] es False (parcial, comas)\n# IN[5] = margen y separacion entre vistas (mm) - debe coincidir con el mismo\n#         input de 02_Colocar vistas en laminas para que el calculo sea exacto\n#\n# QUE DESAPARECIO RESPECTO DEL 01 DE ACERO (T003), Y POR QUE\n#\n# La reserva del lado derecho. En acero, 06_Tabla de assemblies estampaba una tabla\n# de cantidades en la PRIMERA lamina de cada assembly, asi que esa lamina -y solo\n# esa- perdia 150 mm de ancho. Eso obligaba a manejar DOS rectangulos utiles\n# (rect_1 y rect_n) y a que empaquetar() supiera cual usar segun la lamina.\n#\n# Aca no hay tabla: las vistas usan el lienzo COMPLETO de la vineta en todas las\n# laminas. Con un solo rectangulo, empaquetar() pierde el parametro rect_n y la\n# rama que cambiaba de rectangulo al saltar de lamina.\n#\n# OJO: empaquetar() TIENE que ser identica a la de 02_Colocar vistas en laminas. Si\n# las dos versiones se separan, 01 calcula una cantidad de laminas que no coincide\n# con lo que 02 termina colocando, y el error aparece recien al final, con laminas\n# de mas o vistas sin colocar.\n\nimport clr\nimport re\nclr.AddReference(\u0027RevitAPI\u0027)\nclr.AddReference(\u0027RevitServices\u0027)\nfrom Autodesk.Revit.DB import (FilteredElementCollector, ViewSheet,\n                               Viewport, View, BuiltInCategory, Element, ElementId)\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\n\ndoc = DocumentManager.Instance.CurrentDBDocument\n\ntb_type = UnwrapElement(IN[0])\nfirst_number = (IN[1] or \u0027\u0027).strip()\nfirst_name = (IN[2] or \u0027\u0027).strip()\nprocess_all = bool(IN[3])\nfilter_text = (IN[4] or \u0027\u0027).strip()\nmargin = float(IN[5]) / 304.8\n\nlog = []\n\n# --- contrato de nombres con 00_Vistas de sector ---\nSUF_PLANTA = \u0027 - PLANTA\u0027\nSUF_ELEV = \u0027 - ELEV \u0027\n\n# Orden de las elevaciones en la lamina. Es el MISMO orden que fija la tupla\n# ELEVACIONES de 00 (A Norte, B Este, C Sur, D Oeste): cambiarlo alla y no aca\n# dejaria las elevaciones colocadas en un orden que no corresponde con el de sus\n# marcas de corte en la planta.\nLETRAS = (\u0027A\u0027, \u0027B\u0027, \u0027C\u0027, \u0027D\u0027)\n\n# alto reservado bajo cada vista para su titulo (mm de papel)\nlabel_h_planta = 12.0 / 304.8\nlabel_h_elev = (12.0 + 14.0) / 304.8\n\n\ndef elem_name(e):\n    try:\n        return e.Name\n    except Exception:\n        return Element.Name.__get__(e)\n\n\ndef es_elevacion(nombre):\n    return SUF_ELEV in nombre\n\n\ndef tb_label(t):\n    try:\n        return \u0027{} : {}\u0027.format(t.FamilyName, elem_name(t))\n    except Exception:\n        return \u0027Id \u0027 + str(t.Id)\n\n\ndef list_titleblocks():\n    col = (FilteredElementCollector(doc)\n           .OfCategory(BuiltInCategory.OST_TitleBlocks)\n           .WhereElementIsElementType())\n    return list(col)\n\n\ndef paper_size(v):\n    # tamaño en papel (pies) = crop del modelo / escala\n    cb = v.CropBox\n    s = v.Scale if v.Scale \u003e 0 else 1\n    return ((cb.Max.X - cb.Min.X) / s, (cb.Max.Y - cb.Min.Y) / s)\n\n\ndef tamano_con_titulo(v):\n    w, h = paper_size(v)\n    return (w, h + (label_h_elev if es_elevacion(elem_name(v)) else label_h_planta))\n\n\ndef usable_rect(sheet):\n    # area util = bbox de la vineta menos margenes, sin reservar nada: las vistas\n    # ocupan el lienzo completo.\n    col = FilteredElementCollector(doc, sheet.Id).OfCategory(BuiltInCategory.OST_TitleBlocks)\n    tb = col.FirstElement()\n    if tb is not None:\n        bb = tb.get_BoundingBox(sheet)\n        if bb is not None:\n            return (bb.Min.X + margin, bb.Min.Y + margin,\n                    bb.Max.X - margin, bb.Max.Y - margin)\n    o = sheet.Outline\n    return (o.Min.U + margin, o.Min.V + margin,\n            o.Max.U - margin, o.Max.V - margin)\n\n\ndef empaquetar(tamanos, rect, margin):\n    # Flujo izquierda-\u003ederecha, arriba-\u003eabajo. Cuando una vista no cabe a lo ancho\n    # salta de fila; cuando no cabe a lo alto salta a la lamina siguiente DEL MISMO\n    # sector.\n    # Devuelve (posiciones, n_laminas, avisos) con posiciones = [(idx, x_izq, y_sup)].\n    pos = []\n    avisos = []\n    idx = 0\n    x0, y0, x1, y1 = rect\n    cx, cy, row_h = x0, y1, 0.0\n    for w, h in tamanos:\n        if cx \u003e x0 and cx + w \u003e x1:\n            cx = x0\n            cy -= row_h + margin\n            row_h = 0.0\n        fresco = (abs(cx - x0) \u003c 1e-9 and abs(cy - y1) \u003c 1e-9)\n        if cy - h \u003c y0 and not fresco:\n            idx += 1\n            cx, cy, row_h = x0, y1, 0.0\n            fresco = True\n        if fresco and (w \u003e (x1 - x0) or h \u003e (y1 - y0)):\n            avisos.append((w, h))\n        pos.append((idx, cx, cy))\n        cx += w + margin\n        if h \u003e row_h:\n            row_h = h\n    return pos, idx + 1, avisos\n\n\ndef bump(text, steps):\n    # incrementa el ULTIMO bloque numerico conservando el ancho (ceros a la izquierda)\n    last = None\n    for m in re.finditer(\u0027\\\\d+\u0027, text):\n        last = m\n    if last is None:\n        return \u0027{} {:02d}\u0027.format(text, steps + 1)\n    width = len(last.group(0))\n    val = int(last.group(0)) + steps\n    return text[:last.start()] + str(val).zfill(width) + text[last.end():]\n\n\n# --- validar la vineta seleccionada ---\ntb_cat_id = ElementId(BuiltInCategory.OST_TitleBlocks)\nis_tb = (tb_type is not None\n         and tb_type.Category is not None\n         and tb_type.Category.Id == tb_cat_id)\n\nif not is_tb:\n    log.append(\u0027ERROR: el tipo seleccionado en el dropdown NO es una vineta (Title Block).\u0027)\n    log.append(\u0027Selecciona una de estas vinetas cargadas en el proyecto:\u0027)\n    tbs = list_titleblocks()\n    if not tbs:\n        log.append(\u0027  (no hay vinetas cargadas en el proyecto)\u0027)\n    for t in tbs:\n        log.append(\u0027  - \u0027 + tb_label(t))\n    OUT = log\nelse:\n    view_by_name = {}\n    for v in FilteredElementCollector(doc).OfClass(View):\n        if not v.IsTemplate:\n            view_by_name[elem_name(v)] = v\n\n    # --- sectores = los que 00 EFECTIVAMENTE documento ---\n    #\n    # La lista sale de las VISTAS que existen, no de recorrer las vistas 3D con\n    # Section Box. La diferencia importa: 00 es quien decide que es un sector, y\n    # puede haber corrido con un filtro. Si 01 volviera a mirar las vistas 3D por su\n    # cuenta, las dos respuestas se pueden separar.\n    #\n    # Y se separan de la peor manera. El 2026-08-11 este graph conto 9 laminas en vez\n    # de 1: habia SIETE vistas 3D de trabajo (DETALLE 1, DET 2 LAM-004, \"detalle\n    # nuevo fe\"...) con el Section Box encendido, y tener el Section Box encendido no\n    # significa ser un sector. La cuenta era correcta para lo que se le dio de comer;\n    # el problema era de donde salia la lista.\n    #\n    # Leyendo las vistas ya creadas, 01 no puede inventar un sector que 00 no\n    # documento: si no hay \"\u003calgo\u003e - PLANTA\", ese sector no existe para este graph.\n    nombres = []\n    for n in view_by_name:\n        if n.endswith(SUF_PLANTA):\n            nombres.append(n[:-len(SUF_PLANTA)])\n    nombres.sort()\n\n    if not nombres:\n        log.append(\u0027AVISO: no hay ninguna vista \"\u003csector\u003e - PLANTA\" en el modelo; corre antes 00_Vistas de sector.\u0027)\n    if not process_all:\n        tokens = [t.strip().lower() for t in filter_text.split(\u0027,\u0027) if t.strip()]\n        if tokens:\n            nombres = [n for n in nombres if any(tok in n.lower() for tok in tokens)]\n        else:\n            nombres = []\n            log.append(\u0027ERROR: \"Todos\" esta en False y el filtro esta vacio.\u0027)\n    log.append(\u0027Sectores documentados por 00: \u0027 + (\u0027, \u0027.join(nombres) if nombres else \u0027(ninguno)\u0027))\n\n    placed_ids = set()\n    for vp in FilteredElementCollector(doc).OfClass(Viewport):\n        placed_ids.add(vp.ViewId.Value)\n\n    def vistas_pendientes(sname):\n        # orden de lamina: la planta primero, despues las cuatro elevaciones A-\u003eD\n        res = []\n        v = view_by_name.get(sname + SUF_PLANTA)\n        if v is None:\n            log.append(\u0027AVISO: no existe la vista \"{}\" (corre 00_Vistas de sector).\u0027.format(sname + SUF_PLANTA))\n        elif v.Id.Value not in placed_ids:\n            res.append(v)\n        for letra in LETRAS:\n            n = sname + SUF_ELEV + letra\n            v = view_by_name.get(n)\n            if v is None:\n                log.append(\u0027AVISO: no existe la vista \"{}\" (corre 00_Vistas de sector).\u0027.format(n))\n            elif v.Id.Value not in placed_ids:\n                res.append(v)\n        return res\n\n    pendientes = {}\n    for n in nombres:\n        vs = vistas_pendientes(n)\n        if vs:\n            pendientes[n] = vs\n\n    if not pendientes:\n        log.append(\u0027No hay vistas pendientes de colocar; no se creo ninguna lamina.\u0027)\n        OUT = log\n    else:\n        created = 0\n        sheets_needed = 0\n        TransactionManager.Instance.EnsureInTransaction(doc)\n        try:\n            if hasattr(tb_type, \u0027IsActive\u0027) and not tb_type.IsActive:\n                tb_type.Activate()\n\n            # --- medir el area util real de esta vineta con una lamina de prueba ---\n            probe = ViewSheet.Create(doc, tb_type.Id)\n            doc.Regenerate()\n            rect = usable_rect(probe)\n            doc.Delete(probe.Id)\n            log.append(\u0027Area util de la vineta: {:.0f} x {:.0f} mm (margen {:.0f} mm).\u0027.format(\n                (rect[2] - rect[0]) * 304.8, (rect[3] - rect[1]) * 304.8, margin * 304.8))\n\n            # --- simulacion en seco, sector por sector ---\n            for n in sorted(pendientes.keys()):\n                vistas = pendientes[n]\n                tamanos = [tamano_con_titulo(v) for v in vistas]\n                pos, n_lam, avisos = empaquetar(tamanos, rect, margin)\n                sheets_needed += n_lam\n                for w, h in avisos:\n                    log.append(\u0027AVISO {}: una vista de {:.0f} x {:.0f} mm en papel excede el area util de una lamina completa; ocupara una lamina para si sola.\u0027.format(\n                        n, w * 304.8, h * 304.8))\n                log.append(\u0027{}: {} vista(s) -\u003e {} lamina(s).\u0027.format(n, len(vistas), n_lam))\n\n            # --- crear esa cantidad de laminas, con la numeracion de siempre ---\n            if not first_number:\n                first_number = \u0027A-001\u0027\n                log.append(\u0027AVISO: numero inicial vacio, se usa A-001.\u0027)\n            if not first_name:\n                first_name = \u0027SIN NOMBRE 01\u0027\n                log.append(\u0027AVISO: nombre inicial vacio, se usa SIN NOMBRE 01.\u0027)\n\n            existing = set()\n            for vs in FilteredElementCollector(doc).OfClass(ViewSheet):\n                existing.add(vs.SheetNumber)\n\n            plan = []\n            produced = 0\n            offset = 0\n            while produced \u003c sheets_needed and offset \u003c sheets_needed + 1000:\n                num = first_number if offset == 0 else bump(first_number, offset)\n                offset += 1\n                if num in existing:\n                    log.append(\u0027AVISO: el numero {} ya existe en el proyecto, se salta.\u0027.format(num))\n                    continue\n                name = first_name if produced == 0 else bump(first_name, produced)\n                plan.append((num, name))\n                existing.add(num)\n                produced += 1\n\n            for num, name in plan:\n                try:\n                    sheet = ViewSheet.Create(doc, tb_type.Id)\n                    sheet.SheetNumber = num\n                    try:\n                        sheet.Name = name\n                    except Exception:\n                        Element.Name.__set__(sheet, name)\n                    created += 1\n                    log.append(\u0027OK: {}  |  {}\u0027.format(num, name))\n                except Exception as e:\n                    log.append(\u0027ERROR creando {}: {}\u0027.format(num, e))\n        finally:\n            TransactionManager.Instance.TransactionTaskDone()\n\n        log.insert(0, \u0027Vineta usada: \u0027 + tb_label(tb_type))\n        log.insert(1, \u0027Sectores con vistas pendientes: {} | laminas necesarias: {} | creadas: {}\u0027.format(\n            len(pendientes), sheets_needed, created))\n        log.append(\u0027Listo. Ahora corre 02_Colocar vistas en laminas para distribuir las vistas.\u0027)\n        OUT = log\n"
    },
    {
