    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# 03_Taggear plantas y cortes - ILUMINACION (AGRUPACION CONTINUA + MULTIFLECHAS + ANTICOLISIÓN)\n\nimport clr\nimport math\nimport re\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitServices')\nfrom Autodesk.Revit.DB import (FilteredElementCollector, ViewPlan, XYZ, Line,\n                               ReferenceArray, Dimension, DimensionType, Element,\n                               BuiltInCategory, BuiltInParameter, StorageType, ElementId,\n                               FamilyInstance, FamilyInstanceReferenceType, Category,\n                               TextNote, TextNoteType, TextNoteLeaderTypes,\n                               ElementTypeGroup)\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\n\ndoc = DocumentManager.Instance.CurrentDBDocument\n\nprocess_all = bool(IN[0])\nfilter_text = (IN[1] or '').strip()\nfam_prefijo = (IN[2] or '').strip()\nfam_contiene = (IN[3] or '').strip()\noff_mm = float(IN[4]) if IN[4] is not None else 25.0\nsep_min_mm = float(IN[5]) if IN[5] is not None else 500.0\ndim_type_name = (IN[6] or '').strip()\nrehacer = bool(IN[7])\nannot_extra_mm = float(IN[8]) if IN[8] is not None else 15.0\nparam_largo = (IN[9] or 'Longitud').strip()\nparam_codigo = (IN[10] or 'TEXTO PARA TAG').strip()\ntipo_texto_nombre = (IN[11] or '').strip()\nradio_tag_mm = float(IN[12]) if IN[12] is not None else 30.0\nsep_tag_mm = float(IN[13]) if IN[13] is not None else 4.0\nmax_por_texto_in = int(IN[14]) if IN[14] is not None else 0\n\nlog = []\nSUF_PLANTA = ' - PLANTA'\nTOL_PARALELO = 1e-6\nTOL_NORMAL = 1e-3\nLADOS = ('arriba', 'abajo', 'izquierda', 'derecha')\nPREFIJO_TIPO = 'R-'\nRE_CODIGO = re.compile(r'^' + re.escape(PREFIJO_TIPO) + r'\\d+$')\n\n\ndef elem_name(e):\n    try:\n        return Element.Name.GetValue(e)\n    except Exception:\n        try:\n            return e.Name\n        except Exception:\n            return ''\n\n\ndef coincide(nombre, texto):\n    if not texto:\n        return True\n    alto = (nombre or '').upper()\n    for t in texto.split(','):\n        t = t.strip().upper()\n        if t and t in alto:\n            return True\n    return False\n\n\ndef fam_name(el):\n    try:\n        return el.Symbol.Family.Name or ''\n    except Exception:\n        return ''\n\n\ndef es_riel(el):\n    f = fam_name(el).upper()\n    if not f:\n        return False\n    return not fam_prefijo or f.startswith(fam_prefijo.upper())\n\n\ndef es_riel_de_cota(el):\n    if not es_riel(el):\n        return False\n    f = fam_name(el).upper()\n    return not fam_contiene or fam_contiene.upper() in f\n\n\ndef plantas_de_sector():\n    res = []\n    for v in FilteredElementCollector(doc).OfClass(ViewPlan):\n        if v.IsTemplate:\n            continue\n        n = elem_name(v)\n        if not n.endswith(SUF_PLANTA):\n            continue\n        sector = n[:-len(SUF_PLANTA)]\n        if not process_all and not coincide(sector, filter_text):\n            continue\n        res.append((v, sector))\n    res.sort(key=lambda p: p[1])\n    return res\n\n\ndef extremos_en_ejes(el, ex, ey):\n    bb = el.get_BoundingBox(None)\n    if bb is None:\n        return None\n    us, ws = [], []\n    for x in (bb.Min.X, bb.Max.X):\n        for y in (bb.Min.Y, bb.Max.Y):\n            for z in (bb.Min.Z, bb.Max.Z):\n                p = XYZ(x, y, z)\n                us.append(p.DotProduct(ex))\n                ws.append(p.DotProduct(ey))\n    return min(us), max(us), min(ws), max(ws)\n\n\ndef envolvente_de_elementos(elementos, ex, ey):\n    us, ws = [], []\n    for el in elementos:\n        ext = extremos_en_ejes(el, ex, ey)\n        if ext:\n            us.extend([ext[0], ext[1]])\n            ws.extend([ext[2], ext[3]])\n    if not us:\n        return 0, 0, 0, 0\n    return min(us), max(us), min(ws), max(ws)\n\n\ndef referencia_de_eje(inst, eje_medida):\n    try:\n        tr = inst.GetTransform()\n    except Exception:\n        return None, None\n    candidatos = ((FamilyInstanceReferenceType.CenterLeftRight, tr.BasisX),\n                  (FamilyInstanceReferenceType.CenterFrontBack, tr.BasisY))\n    for tipo, normal in candidatos:\n        try:\n            n = normal.Normalize()\n        except Exception:\n            continue\n        if abs(abs(n.DotProduct(eje_medida)) - 1.0) > TOL_NORMAL:\n            continue\n        try:\n            refs = list(inst.GetReferences(tipo))\n        except Exception:\n            refs = []\n        if refs:\n            return refs[0], n\n    return None, None\n\n\ndef canonica(n):\n    if n.X > 1e-12:\n        return n\n    if n.X < -1e-12:\n        return n.Negate()\n    return n if n.Y >= 0 else n.Negate()\n\n\ndef alinear(items):\n    if not items:\n        return [], 0, 0.0\n    cubetas = {}\n    for it in items:\n        d = canonica(it[3])\n        k = int(round(math.atan2(d.Y, d.X) / TOL_PARALELO))\n        acc = cubetas.get(k)\n        if acc is None:\n            cubetas[k] = [1, d]\n        else:\n            acc[0] += 1\n    dom = max(cubetas.values(), key=lambda a: a[0])[1]\n    ok = []\n    fuera = 0\n    peor = 0.0\n    for it in items:\n        s = abs(it[3].X * dom.Y - it[3].Y * dom.X)\n        if s <= TOL_PARALELO / 2.0:\n            ok.append(it)\n        else:\n            fuera += 1\n            if s > peor:\n                peor = s\n    return ok, fuera, peor\n\n\ndef tipo_de_cota(nombre):\n    if not nombre:\n        return None\n    for dt in FilteredElementCollector(doc).OfClass(DimensionType):\n        if elem_name(dt) == nombre:\n            return dt\n    return None\n\n\ndef cadenas_de_riel_existentes(v):\n    res = []\n    for dim in FilteredElementCollector(doc, v.Id).OfClass(Dimension):\n        try:\n            for ref in dim.References:\n                el = doc.GetElement(ref.ElementId)\n                if el is not None and isinstance(el, FamilyInstance) and es_riel(el):\n                    res.append(dim.Id)\n                    break\n        except Exception:\n            pass\n    return res\n\n\ndef dibujar_cadena(v, items, eje_medida, eje_perp, valor_perp, sep_min, z_plano, dim_type):\n    if len(items) < 2:\n        return 0\n    items, _, _ = alinear(items)\n    if len(items) < 2:\n        return 0\n    items.sort(key=lambda it: it[0])\n    filtrados = []\n    ultimo = None\n    for it in items:\n        if ultimo is None or it[0] - ultimo > sep_min:\n            filtrados.append(it)\n            ultimo = it[0]\n    if len(filtrados) < 2:\n        return 0\n    ra = ReferenceArray()\n    for it in filtrados:\n        ra.Append(it[1])\n\n    p1 = eje_medida.Multiply(filtrados[0][0]).Add(eje_perp.Multiply(valor_perp))\n    p2 = eje_medida.Multiply(filtrados[-1][0]).Add(eje_perp.Multiply(valor_perp))\n    p1 = XYZ(p1.X, p1.Y, z_plano)\n    p2 = XYZ(p2.X, p2.Y, z_plano)\n\n    if p1.DistanceTo(p2) < 1e-6:\n        return 0\n    try:\n        if dim_type is not None:\n            doc.Create.NewDimension(v, Line.CreateBound(p1, p2), ra, dim_type)\n        else:\n            doc.Create.NewDimension(v, Line.CreateBound(p1, p2), ra)\n        return 1\n    except Exception:\n        return 0\n\n\ndef anotar_planta(v, sector, dim_type):\n    escala = v.Scale or 1\n    papel = lambda mm: float(mm) / 304.8 * escala\n\n    off = papel(off_mm)\n    sep_min = papel(sep_min_mm)\n\n    if rehacer:\n        for did in cadenas_de_riel_existentes(v):\n            try:\n                doc.Delete(did)\n            except Exception:\n                pass\n\n    rieles = [el for el in FilteredElementCollector(doc, v.Id)\n              .OfCategory(BuiltInCategory.OST_ElectricalFixtures)\n              .WhereElementIsNotElementType()\n              if isinstance(el, FamilyInstance) and es_riel_de_cota(el)]\n    if not rieles:\n        return 0\n\n    ex = v.RightDirection.Normalize()\n    ey = v.UpDirection.Normalize()\n    z_plano = v.Origin.Z\n\n    u0_r, u1_r, w0_r, w1_r = envolvente_de_elementos(rieles, ex, ey)\n    u_mid = (u0_r + u1_r) / 2.0\n    w_mid = (w0_r + w1_r) / 2.0\n\n    grupos = dict((lado, []) for lado in LADOS)\n    for el in rieles:\n        ext = extremos_en_ejes(el, ex, ey)\n        if ext is None:\n            continue\n        au0, au1, aw0, aw1 = ext\n        span_u, span_w = au1 - au0, aw1 - aw0\n        uc, wc = (au0 + au1) / 2.0, (aw0 + aw1) / 2.0\n\n        if max(span_u, span_w) < 1.2 * min(span_u, span_w):\n            continue\n        if span_u > span_w:\n            lado = 'izquierda' if uc < u_mid else 'derecha'\n            eje_medida, pos = ey, wc\n        else:\n            lado = 'abajo' if wc < w_mid else 'arriba'\n            eje_medida, pos = ex, uc\n\n        ref, normal = referencia_de_eje(el, eje_medida)\n        if ref:\n            grupos[lado].append((pos, ref, elem_name(el), normal))\n\n    n = 0\n    n += dibujar_cadena(v, grupos['arriba'], ex, ey, w1_r + off, sep_min, z_plano, dim_type)\n    n += dibujar_cadena(v, grupos['abajo'], ex, ey, w0_r - off, sep_min, z_plano, dim_type)\n    n += dibujar_cadena(v, grupos['izquierda'], ey, ex, u0_r - off, sep_min, z_plano, dim_type)\n    n += dibujar_cadena(v, grupos['derecha'], ey, ex, u1_r + off, sep_min, z_plano, dim_type)\n    return n\n\n\n# ----------------------------- TAGS CON AGRUPACIÓN REAL Y ANTICOLISIÓN -----------------------------\n\ndef largo_mm(el):\n    try:\n        p = el.LookupParameter(param_largo)\n        return int(round(p.AsDouble() * 304.8)) if p and p.HasValue else None\n    except Exception:\n        return None\n\n\ndef rieles_del_modelo():\n    return [el for el in FilteredElementCollector(doc)\n            .OfCategory(BuiltInCategory.OST_ElectricalFixtures)\n            .WhereElementIsNotElementType()\n            if isinstance(el, FamilyInstance) and es_riel(el)]\n\n\ndef tabla_de_tipos(rieles):\n    largos = sorted(set(l for l in (largo_mm(e) for e in rieles) if l is not None))\n    return dict((l, '{}{:02d}'.format(PREFIJO_TIPO, i + 1)) for i, l in enumerate(largos))\n\n\ndef tipo_de_texto(nombre):\n    objetivo = (nombre or '').strip().upper()\n    for tt in FilteredElementCollector(doc).OfClass(TextNoteType):\n        if objetivo and elem_name(tt).upper() == objetivo:\n            return tt.Id\n    return doc.GetDefaultElementTypeId(ElementTypeGroup.TextNoteType)\n\n\ndef agrupar_rieles_contiguos(rieles_info, radio_gap_ft, max_tope, ex, ey):\n    \"\"\"\n    Agrupa rieles por LÍNEA FÍSICA y por CÓDIGO de forma continua, generando 1 solo grupo por código por tramo.\n    \"\"\"\n    if not rieles_info:\n        return []\n\n    TOL_EJE = 0.8  # Tolerancia alineación en pies (~25 cm)\n    lineas_fisicas = []\n    usados = set()\n    n = len(rieles_info)\n\n    # 1. Identificar tramos lineales\n    for i in range(n):\n        if i in usados:\n            continue\n        item_i = rieles_info[i]\n        linea_actual = [item_i]\n        usados.add(i)\n\n        for j in range(i + 1, n):\n            if j in usados:\n                continue\n            item_j = rieles_info[j]\n\n            dx = abs(item_i[1].X - item_j[1].X)\n            dy = abs(item_i[1].Y - item_j[1].Y)\n\n            if dy < TOL_EJE or dx < TOL_EJE:\n                linea_actual.append(item_j)\n                usados.add(j)\n\n        lineas_fisicas.append(linea_actual)\n\n    # 2. Agrupar por CODIGO dentro de cada tramo\n    grupos_finales = []\n    for linea in lineas_fisicas:\n        por_codigo = {}\n        for item in linea:\n            cod = item[3]\n            if cod not in por_codigo:\n                por_codigo[cod] = []\n            por_codigo[cod].append(item)\n\n        for cod, items_cod in por_codigo.items():\n            us = [it[1].DotProduct(ex) for it in items_cod]\n            ws = [it[1].DotProduct(ey) for it in items_cod]\n            es_horiz = (max(us) - min(us)) >= (max(ws) - min(ws))\n\n            if es_horiz:\n                items_cod.sort(key=lambda it: it[1].DotProduct(ex))\n            else:\n                items_cod.sort(key=lambda it: it[1].DotProduct(ey))\n\n            sub_grupo = [items_cod[0]]\n            for it in items_cod[1:]:\n                prev = sub_grupo[-1]\n                dist = it[1].DistanceTo(prev[1])\n                if dist <= radio_gap_ft:\n                    sub_grupo.append(it)\n                else:\n                    grupos_finales.append(sub_grupo)\n                    sub_grupo = [it]\n            if sub_grupo:\n                grupos_finales.append(sub_grupo)\n\n    # 3. Aplicar tope máximo si está configurado (> 0)\n    grupos_con_tope = []\n    for g in grupos_finales:\n        if max_tope > 0 and len(g) > max_tope:\n            for sub_i in range(0, len(g), max_tope):\n                grupos_con_tope.append(g[sub_i:sub_i + max_tope])\n        else:\n            grupos_con_tope.append(g)\n\n    return grupos_con_tope\n\n\ndef resolver_posicion_tag(pt_base, ex, ey, dist_pegado, es_horiz, colocados, escala):\n    \"\"\"\n    Desplaza la nota de texto si detecta un texto ya colocado en la misma coordenada.\n    \"\"\"\n    if not colocados:\n        return pt_base\n\n    ft_a_mm_papel = lambda ft: (ft * 304.8) / escala\n    u_b = pt_base.DotProduct(ex)\n    w_b = pt_base.DotProduct(ey)\n    z = pt_base.Z\n\n    candidatos = [pt_base]\n\n    if es_horiz:\n        # Alternar lado (+dist / -dist)\n        candidatos.append(XYZ(ex.Multiply(u_b).Add(ey.Multiply(w_b - 2.0 * dist_pegado)).X,\n                              ex.Multiply(u_b).Add(ey.Multiply(w_b - 2.0 * dist_pegado)).Y, z))\n        # Desplazamientos a lo largo del eje\n        for shift_mm in [12.0, -12.0, 24.0, -24.0]:\n            sh_ft = (shift_mm / 304.8) * escala\n            candidatos.append(XYZ(ex.Multiply(u_b + sh_ft).Add(ey.Multiply(w_b)).X,\n                                  ex.Multiply(u_b + sh_ft).Add(ey.Multiply(w_b)).Y, z))\n    else:\n        candidatos.append(XYZ(ex.Multiply(u_b - 2.0 * dist_pegado).Add(ey.Multiply(w_b)).X,\n                              ex.Multiply(u_b - 2.0 * dist_pegado).Add(ey.Multiply(w_b)).Y, z))\n        for shift_mm in [12.0, -12.0, 24.0, -24.0]:\n            sh_ft = (shift_mm / 304.8) * escala\n            candidatos.append(XYZ(ex.Multiply(u_b).Add(ey.Multiply(w_b + sh_ft)).X,\n                                  ex.Multiply(u_b).Add(ey.Multiply(w_b + sh_ft)).Y, z))\n\n    min_gap_mm = 10.0  # Distancia mínima entre etiquetas en espacio de papel\n\n    for cand in candidatos:\n        conflict = False\n        for exist in colocados:\n            if ft_a_mm_papel(cand.DistanceTo(exist)) < min_gap_mm:\n                conflict = True\n                break\n        if not conflict:\n            return cand\n\n    return candidatos[0]\n\n\ndef crear_texto_etiqueta_multiflecha(v, texto, pt_texto, pts_destino, tt_id, ex):\n    tn = TextNote.Create(doc, v.Id, pt_texto, texto, tt_id)\n    u_texto = pt_texto.DotProduct(ex)\n\n    for pt_dest in pts_destino:\n        u_dest = pt_dest.DotProduct(ex)\n        tipo = TextNoteLeaderTypes.TNLT_STRAIGHT_R if u_dest >= u_texto else TextNoteLeaderTypes.TNLT_STRAIGHT_L\n        try:\n            ld = tn.AddLeader(tipo)\n            ld.End = pt_dest\n        except Exception:\n            pass\n    return tn\n\n\ndef taggear_planta(v, sector, tt_id, mapa):\n    escala = v.Scale or 1\n    papel = lambda mm: float(mm) / 304.8 * escala\n\n    rad_mm = radio_tag_mm if radio_tag_mm > 0 else 50.0\n    radio_gap_ft = papel(rad_mm)\n    dist_pegado = max(papel(sep_tag_mm), papel(5.0))\n\n    if rehacer:\n        for tn in FilteredElementCollector(doc, v.Id).OfClass(TextNote):\n            if RE_CODIGO.match((tn.Text or '').strip()):\n                try:\n                    doc.Delete(tn.Id)\n                except Exception:\n                    pass\n\n    rieles = [el for el in FilteredElementCollector(doc, v.Id)\n              .OfCategory(BuiltInCategory.OST_ElectricalFixtures)\n              .WhereElementIsNotElementType()\n              if isinstance(el, FamilyInstance) and es_riel(el)]\n    if not rieles:\n        return 0\n\n    ex = v.RightDirection.Normalize()\n    ey = v.UpDirection.Normalize()\n    z_plano = v.Origin.Z\n\n    u0_r, u1_r, w0_r, w1_r = envolvente_de_elementos(rieles, ex, ey)\n    u_mid = (u0_r + u1_r) / 2.0\n    w_mid = (w0_r + w1_r) / 2.0\n\n    rieles_info = []\n    for el in rieles:\n        l = largo_mm(el)\n        if l and l in mapa:\n            bb = el.get_BoundingBox(v) or el.get_BoundingBox(None)\n            if bb:\n                centro = XYZ((bb.Min.X + bb.Max.X) / 2.0, (bb.Min.Y + bb.Max.Y) / 2.0, z_plano)\n                rieles_info.append((el, centro, bb, mapa[l]))\n\n    grupos = agrupar_rieles_contiguos(rieles_info, radio_gap_ft, max_por_texto_in, ex, ey)\n    puestos = 0\n    textos_colocados = []\n\n    for grupo in grupos:\n        codigo = grupo[0][3]\n        pts_destino = [m[1] for m in grupo]\n        us = [p.DotProduct(ex) for p in pts_destino]\n        ws = [p.DotProduct(ey) for p in pts_destino]\n\n        span_u = max(us) - min(us)\n        span_w = max(ws) - min(ws)\n        es_horiz = span_u >= span_w\n\n        u_centro = (min(us) + max(us)) / 2.0\n        w_centro = (min(ws) + max(ws)) / 2.0\n\n        if es_horiz:\n            u_texto = u_centro\n            w_texto = min(ws) - dist_pegado if w_centro > w_mid else max(ws) + dist_pegado\n        else:\n            w_texto = w_centro\n            u_texto = min(us) - dist_pegado if u_centro > u_mid else max(us) + dist_pegado\n\n        pt_base = ex.Multiply(u_texto).Add(ey.Multiply(w_texto))\n        pt_base = XYZ(pt_base.X, pt_base.Y, z_plano)\n\n        pt_texto = resolver_posicion_tag(pt_base, ex, ey, dist_pegado, es_horiz, textos_colocados, escala)\n        textos_colocados.append(pt_texto)\n\n        try:\n            crear_texto_etiqueta_multiflecha(v, codigo, pt_texto, pts_destino, tt_id, ex)\n            puestos += 1\n        except Exception:\n            pass\n\n    return puestos\n\n\n# --- EJECUCIÓN PRINCIPAL ---\nplantas = plantas_de_sector()\nif plantas:\n    dim_type = tipo_de_cota(dim_type_name)\n    tt_id = tipo_de_texto(tipo_texto_nombre)\n\n    TransactionManager.Instance.EnsureInTransaction(doc)\n    rieles_modelo = rieles_del_modelo()\n    mapa = tabla_de_tipos(rieles_modelo)\n\n    cotas, tags = 0, 0\n    for v, sector in plantas:\n        cotas += anotar_planta(v, sector, dim_type)\n        if mapa:\n            tags += taggear_planta(v, sector, tt_id, mapa)\n\n    TransactionManager.Instance.ForceCloseTransaction()\n    log.append('Proceso completado: Etiquetas unificadas por tramo con multiflecha limpias.')\n\nOUT = log",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
